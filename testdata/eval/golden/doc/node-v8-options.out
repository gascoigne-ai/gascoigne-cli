The following syntax for options is accepted (both '-' and '--' are ok):
  --flag        (bool flags only)
  --no-flag     (bool flags only)
  --flag=value  (non-bool flags only, no spaces around '=')
  --flag value  (non-bool flags only)
  --            (captures all remaining args in JavaScript)

Options:
  --experimental (Indicates that V8 is running with experimental features enabled. This flag is typically not set explicitly but instead enabled as an implication of other flags which enable experimental features.)
        type: bool  default: --no-experimental
  --test-only-unsafe (Indicates that V8 is running in an unsupported and unsafe configuration, e.g. used for internal testing. This flag is typically not set explicitly but instead enabled as an implication of other flags)
        type: bool  default: --no-test-only-unsafe
  --abort-on-contradictory-flags (Disallow flags or implications overriding each other.)
        type: bool  default: --no-abort-on-contradictory-flags
  --exit-on-contradictory-flags (Exit with return code 0 on contradictory flags.)
        type: bool  default: --no-exit-on-contradictory-flags
  --allow-overwriting-for-next-flag (temporary disable flag contradiction to allow overwriting just the next flag)
        type: bool  default: --no-allow-overwriting-for-next-flag
  --use-strict (enforce strict mode)
        type: bool  default: --no-use-strict
  --trace-temporal (trace temporal code)
        type: bool  default: --no-trace-temporal
  --harmony (enable all completed harmony features)
        type: bool  default: --no-harmony
  --harmony-shipping (enable all shipped harmony features)
        type: bool  default: --harmony-shipping
  --js-staging (enable all completed JavaScript features)
        type: bool  default: --no-js-staging
  --js-shipping (enable all shipped JavaScript features)
        type: bool  default: --js-shipping
  --harmony-shadow-realm (enable "harmony ShadowRealm" (in progress / experimental))
        type: bool  default: --no-harmony-shadow-realm
  --harmony-struct (enable "harmony structs, shared structs, and shared arrays" (in progress / experimental))
        type: bool  default: --no-harmony-struct
  --harmony-intl-best-fit-matcher (enable "Intl BestFitMatcher" (in progress / experimental))
        type: bool  default: --no-harmony-intl-best-fit-matcher
  --js-decorators (enable "decorators" (in progress / experimental))
        type: bool  default: --no-js-decorators
  --js-source-phase-imports (enable "source phase imports" (in progress / experimental))
        type: bool  default: --js-source-phase-imports
  --js-defer-import-eval (enable "defer import eval" (in progress / experimental))
        type: bool  default: --no-js-defer-import-eval
  --js-immutable-arraybuffer (enable "Immutable ArrayBuffer")
        type: bool  default: --no-js-immutable-arraybuffer
  --js-sum-precise (enable "Math.sumPrecise")
        type: bool  default: --no-js-sum-precise
  --js-intl-locale-variants (enable "Intl.Locale.prototype.variants")
        type: bool  default: --no-js-intl-locale-variants
  --harmony-import-attributes (enable "harmony import attributes")
        type: bool  default: --harmony-import-attributes
  --harmony-temporal (enable "Temporal")
        type: bool  default: --harmony-temporal
  --js-regexp-duplicate-named-groups (enable "RegExp duplicate named groups")
        type: bool  default: --js-regexp-duplicate-named-groups
  --js-regexp-modifiers (enable "RegExp modifiers")
        type: bool  default: --js-regexp-modifiers
  --js-promise-try (enable "Promise.try")
        type: bool  default: --js-promise-try
  --js-atomics-pause (enable "Atomics.pause")
        type: bool  default: --js-atomics-pause
  --js-error-iserror (enable "Error.isError")
        type: bool  default: --js-error-iserror
  --js-regexp-escape (enable "RegExp.escape")
        type: bool  default: --js-regexp-escape
  --js-explicit-resource-management (enable "explicit resource management")
        type: bool  default: --js-explicit-resource-management
  --js-float16array (enable "Float16Array, Math.f16round, DataView.getFloat16, DataView.setFloat16")
        type: bool  default: --js-float16array
  --js-base-64 (enable "Uint8Array to/from base64 and hex")
        type: bool  default: --js-base-64
  --js-esm-ns-reexport (enable "Support diamond-importing re-expored namespaces " "(https://github.com/tc39/ecma262/pull/3715)")
        type: bool  default: --js-esm-ns-reexport
  --js-upsert (enable "upsert")
        type: bool  default: --js-upsert
  --js-iterator-sequencing (enable "iterator sequencing")
        type: bool  default: --js-iterator-sequencing
  --builtin-subclassing (subclassing support in built-in methods)
        type: bool  default: --builtin-subclassing
  --enable-sharedarraybuffer-per-context (enable the SharedArrayBuffer constructor per context)
        type: bool  default: --no-enable-sharedarraybuffer-per-context
  --js-nonextensible-applies-to-private (non-extensibility includes private fields)
        type: bool  default: --no-js-nonextensible-applies-to-private
  --for-of-optimization (Experimental flag for improving ForOf loops on ArrayIterator (experimental))
        type: bool  default: --no-for-of-optimization
  --icu-timezone-data (get information about timezones from ICU)
        type: bool  default: --icu-timezone-data
  --icu-datetime-compat-lang (limits ICU date time compat changes to the given language)
        type: string  default: --icu-datetime-compat-lang="*"
  --icu-default-italian-number-grouping-always (override the default useGrouping rule for Italian to "always" to match behavior of ICU <76)
        type: bool  default: --no-icu-default-italian-number-grouping-always
  --icu-british-remove-full-weekday-comma (remove any comma after a full weekday in en-AU, en-GB and en-IN to match behavior of ICU<76)
        type: bool  default: --no-icu-british-remove-full-weekday-comma
  --stress-snapshot (disables sharing of the read-only heap for testing)
        type: bool  default: --no-stress-snapshot
  --lite-mode (enables trade-off of performance for memory savings)
        type: bool  default: --no-lite-mode
  --enable-allocation-folding (Use allocation folding globally)
        type: bool  default: --enable-allocation-folding
  --disable-write-barriers (disable write barriers when GC is non-incremental and heap contains single generation.)
        type: bool  default: --no-disable-write-barriers
  --enable-unconditional-write-barriers (always use full write barriers)
        type: bool  default: --no-enable-unconditional-write-barriers
  --single-generation (allocate all objects from young generation to old generation)
        type: bool  default: --no-single-generation
  --conservative-stack-scanning (use conservative stack scanning (experimental))
        type: bool  default: --no-conservative-stack-scanning
  --direct-handle (use direct handles with conservative stack scanning)
        type: bool  default: --no-direct-handle
  --scavenger-conservative-object-pinning (Objects reachable from the native stack during scavenge will be pinned and won't move.)
        type: bool  default: --no-scavenger-conservative-object-pinning
  --stress-scavenger-conservative-object-pinning (Treat some precise references as conservative references to stress test object pinning in Scavenger)
        type: bool  default: --no-stress-scavenger-conservative-object-pinning
  --stress-scavenger-conservative-object-pinning-random (Enables random stressing of object pinning in Scavenger, such that each GC would randomly pick a subset of the precise references to treat conservatively)
        type: bool  default: --no-stress-scavenger-conservative-object-pinning-random
  --scavenger-precise-object-pinning (Objects reachable from handles during scavenge will be pinned and won't move.)
        type: bool  default: --no-scavenger-precise-object-pinning
  --scavenger-updates-allocation-limit (Scavenger updates allocation limits if allocation rate is low)
        type: bool  default: --scavenger-updates-allocation-limit
  --precise-object-pinning (Objects reachable from handles during GC will be pinned and won't move.)
        type: bool  default: --no-precise-object-pinning
  --scavenger-promote-quarantined-pages (Quarantined pages in the intermediate generation will be promoted to old space)
        type: bool  default: --scavenger-promote-quarantined-pages
  --scavenger-chaos-mode (Scavenger will ignore age when making promotion decisions and instead choose objects to be promoted at random. This only applies to non-large objects.)
        type: bool  default: --no-scavenger-chaos-mode
  --scavenger-chaos-mode-threshold (Percentage of non-large young objects that will be promoted during Scavenger in chaos mode)
        type: uint  default: --scavenger-chaos-mode-threshold=50
  --local-off-stack-check (check for off-stack allocation of v8::Local)
        type: bool  default: --no-local-off-stack-check
  --experimental-fuzzing (Implies all experimental pre-staged features that can already be fuzzed but are not ready for staging yet.)
        type: bool  default: --no-experimental-fuzzing
  --future (Implies all staged features that we want to ship in the not-too-far future)
        type: bool  default: --no-future
