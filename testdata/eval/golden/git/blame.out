   57 var (
   58 	// wrappers are skipped to find the real command.
   59 	wrappers = map[string]bool{"sudo": true, "time": true, "env": true, "command": true, "exec": true, "nice": true, "nohup": true}
   60 	// runners execute the package named next: "npx nx run-many" is nx.
   61 	runners = map[string]bool{"npx": true, "bunx": true, "pnpx": true, "uvx": true, "pipx": true}
