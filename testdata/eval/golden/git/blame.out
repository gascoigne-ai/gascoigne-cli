   14 
   15 type Hints struct {
   16 	Cmd  string // command line that produced the text
   17 	File string // source file path
   18 	MIME string // e.g. from an HTTP Content-Type header
   19 }
   20 
   21 // HintsFrom reads hints from payload attrs.
   22 func HintsFrom(attrs map[string]string) Hints {
   23 	return Hints{Cmd: attrs["cmd"], File: attrs["file"], MIME: attrs["mime"]}
   24 }
   25 
   26 func Detect(text string, h Hints) string {
e6a4e569 dev 2026-10-10
   27 	for _, t := range []string{FromCmd(h.Cmd), FromFile(h.File), FromMIME(h.MIME)} {
   28 		if t != "" {
   29 			return refine(t, text)
   30 		}
54c53fae dev 2026-10-10
   31 	}
   32 	return Sniff(text)
   33 }
