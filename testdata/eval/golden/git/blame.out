  117 // flagValue returns the value of -o yaml, -o=yaml, -oyaml style flags.
  118 func flagValue(args []string, names ...string) string {
  119 	for i, a := range args {
  120 		for _, n := range names {
  121 			switch {
  122 			case a == n && i+1 < len(args):
  123 				return args[i+1]
  124 			case strings.HasPrefix(a, n+"="):
  125 				return a[len(n)+1:]
  126 			case len(n) == 2 && strings.HasPrefix(a, n) && len(a) > 2 && a[2] != '-':
  127 				return a[2:]
  128 			}
54c53fae dev 2026-10-10
  129 		}
  130 	}
  131 	return ""
  132 }
