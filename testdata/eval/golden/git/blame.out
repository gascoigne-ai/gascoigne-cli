602c5ffb dev 2026-10-10
   51 // Dialect is the dialect part of a type: "jest" for "test/jest".
   52 func Dialect(typ string) string {
   53 	_, dialect, _ := strings.Cut(typ, "/")
   54 	return dialect
   55 }
