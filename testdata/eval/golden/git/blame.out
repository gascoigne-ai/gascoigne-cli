   64 // Argv splits cmd, drops env assignments and wrappers, unwraps package
   65 // runners and reduces the program to its base name.
54c53fae dev 2026-10-10
   66 func Argv(cmd string) []string {
   67 	args := strings.Fields(cmd)
602c5ffb dev 2026-10-10
   68 	for len(args) > 0 && (strings.Contains(args[0], "=") || wrappers[path.Base(args[0])] || runners[path.Base(args[0])] && len(args) > 1) {
54c53fae dev 2026-10-10
   69 		args = args[1:]
602c5ffb dev 2026-10-10
