  142 // Command names a command line for reports: the program plus its subcommands
  143 // for multi-command tools ("go test", "aws s3 ls", "npx nx run-many" → "nx run-many").
bd97b2af dev 2026-10-10
  144 func Command(cmd string) string {
  145 	args := Argv(cmd)
  146 	if len(args) == 0 {
  147 		return ""
  148 	}
602c5ffb dev 2026-10-10
  149 	pos := positional(args)
  150 	n := min(subcommandTools[args[0]], len(pos))
  151 	return strings.Join(append([]string{args[0]}, pos[:n]...), " ")
  152 }
  153 
  154 // lastArg is the last positional argument (the file of cat, head, tail).
  155 func lastArg(args []string) string {
  156 	pos := positional(args)
  157 	if len(pos) == 0 {
  158 		return ""
bd97b2af dev 2026-10-10
  159 	}
602c5ffb dev 2026-10-10
  160 	return pos[len(pos)-1]
bd97b2af dev 2026-10-10
  161 }
