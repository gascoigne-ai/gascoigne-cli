   99 // positional returns arguments after the program that are not flags or flag values.
  100 func positional(args []string) []string {
  101 	var out []string
54c53fae dev 2026-10-10
  102 	for i := 1; i < len(args); i++ {
  103 		switch a := args[i]; {
  104 		case valueFlags[a]:
  105 			i++
  106 		case !strings.HasPrefix(a, "-"):
602c5ffb dev 2026-10-10
  107 			out = append(out, a)
54c53fae dev 2026-10-10
  108 		}
  109 	}
602c5ffb dev 2026-10-10
  110 	return out
54c53fae dev 2026-10-10
  111 }
