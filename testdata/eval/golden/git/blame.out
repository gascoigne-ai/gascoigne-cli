e6a4e569 dev 2026-10-10
   35 // refine swaps a generic type for a spec refining it whose sniffer matches.
   36 func refine(t, text string) string {
   37 	for _, s := range specs {
   38 		if slices.Contains(s.Refines, t) && s.Sniff(text, sample(text)) {
   39 			return s.Type
   40 		}
   41 	}
   42 	return t
   43 }
