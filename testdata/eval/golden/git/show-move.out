diff compress/rows/hash.go (new)
@@ -0,0 +1,57 @@
+package rows
+
+import (
+	"encoding/json"
+	"hash/maphash"
+	"slices"
+)
+
+var seed = maphash.MakeSeed()
+
+// hash fingerprints a decoded JSON value; equal values hash equally.
+func hash(v any) uint64 {
+	var h maphash.Hash
+	h.SetSeed(seed)
+	writeHash(&h, v)
+	return h.Sum64()
+}
+
+func writeHash(h *maphash.Hash, v any) {
+	switch v := v.(type) {
+	case nil:
+		h.WriteByte('n')
+	case bool:
+		if v {
+			h.WriteByte('t')
+		} else {
+			h.WriteByte('f')
+		}
+	case string:
+		h.WriteByte('s')
+		h.WriteString(v)
+		h.WriteByte(0)
+	case json.Number:
+		h.WriteByte('#')
+		h.WriteString(string(v))
+		h.WriteByte(0)
+	case []any:
+		h.WriteByte('[')
+		for _, x := range v {
+			writeHash(h, x)
+		}
+		h.WriteByte(']')
+	case map[string]any:
+		h.WriteByte('{')
+		keys := make([]string, 0, len(v))
+		for k := range v {
+			keys = append(keys, k)
+		}
+		slices.Sort(keys)
+		for _, k := range keys {
+			h.WriteString(k)
+			h.WriteByte(0)
+			writeHash(h, v[k])
+		}
+		h.WriteByte('}')
+	}
+}
