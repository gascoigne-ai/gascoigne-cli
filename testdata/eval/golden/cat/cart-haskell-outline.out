  -- … L52-55

class Priced a where
  unitPrice :: a -> Int
  lineTotal :: a -> Int -> Int
  lineTotal x n =
    let p = unitPrice x
        d = if n >= 10 then p `div` 10 else 0
    in (p - d) * n

instance Priced Item where
  unitPrice = price
