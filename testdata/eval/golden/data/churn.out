# Churn analysis

Load monthly orders and fit a simple churn model.
# %% [2] code In[1]
import pandas as pd
import matplotlib.pyplot as plt
from sklearn.linear_model import LogisticRegression

df = pd.read_csv('orders.csv', parse_dates=['month'])
df.head()
